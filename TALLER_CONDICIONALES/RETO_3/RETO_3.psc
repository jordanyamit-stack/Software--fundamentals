Algoritmo sin_titulo
	Escribir "VALOR DEL NUMERO"
	// digitar numero//

	Leer numero
	// proseso//

	Si numero % 2 = 0 Entonces
		// positivo//

		Si numero > 0 Entonces
			Escribir "Par positivo"
		Sino
			Escribir "Par negativo"
		FinSi
	Sino
		// negativo//

		Si numero > 0 Entonces
			Escribir "Impar positivo"
		Sino
			Escribir "Impar negativo"
		FinSi
	FinSi
FinAlgoritmo
