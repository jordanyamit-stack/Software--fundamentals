    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Real" array="False" size=""/>
            <assign variable="numero" expression="0"/>
            <output expression="&quot;ingrese el numero entero (positivo o negativo)&quot;" newline="True"/>
            <input variable="numero"/>
            <if expression="numero%2=0">
                <then>
                    <output expression="&quot;el numero &quot; &amp; numero &amp; &quot; es par&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;el numero &quot; &amp; numero &amp; &quot; es impar&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
