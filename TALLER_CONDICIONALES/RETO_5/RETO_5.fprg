<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="RETO_5"/>
        <attribute name="authors" value="rtx3050"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-23 09:11:49 p.&#8239;m."/>
        <attribute name="created" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0xNTswNzozNDo1NiBwLuKAr20uOzExMjY1"/>
        <attribute name="edited" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yMzswOToxMTo0OSBwLuKAr20uOzI7MTEzNzI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="identificacion" type="String" array="False" size=""/>
            <declare name="nombres" type="String" array="False" size=""/>
            <declare name="apellidos" type="String" array="False" size=""/>
            <declare name="genero" type="String" array="False" size=""/>
            <declare name="a&#241;onacimiento" type="Integer" array="False" size=""/>
            <declare name="direccion" type="Integer" array="False" size=""/>
            <declare name="telefono" type="Integer" array="False" size=""/>
            <declare name="salario" type="Integer" array="False" size=""/>
            <declare name="salariofinal" type="Integer" array="False" size=""/>
            <declare name="salariototal" type="Integer" array="False" size=""/>
            <output expression="&quot;digite el nombre&quot;" newline="True"/>
            <input variable="nombres"/>
            <output expression="&quot;digite los apellidos&quot;" newline="True"/>
            <input variable="apellidos"/>
            <output expression="&quot;digite la identificacion&quot;" newline="True"/>
            <input variable="identificacion"/>
            <output expression="&quot;digite el genero&quot;" newline="True"/>
            <input variable="genero"/>
            <output expression="&quot;digite el a&#241;o de nacimiento&quot;" newline="True"/>
            <input variable="a&#241;onacimiento"/>
            <output expression="&quot;digite la direccion&quot;" newline="True"/>
            <input variable="direccion"/>
            <output expression="&quot;digite el telefono&quot;" newline="True"/>
            <input variable="telefono"/>
            <output expression="&quot;digite el salario&quot;" newline="True"/>
            <input variable="salario"/>
            <if expression="salario&lt;=1200000">
                <then>
                    <if expression="genero=&quot;f&quot;">
                        <then>
                            <assign variable="salariofinal" expression="salario*0.3"/>
                        </then>
                        <else>
                            <assign variable="salariofinal" expression="salario*0.25"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="salario&lt;2000000">
                        <then>
                            <assign variable="salariofinal" expression="salario*0.05"/>
                        </then>
                        <else>
                            <if expression="genero=&quot;f&quot;">
                                <then>
                                    <assign variable="salariofinal" expression="salario*0.03"/>
                                </then>
                                <else>
                                    <assign variable="salarioFINAL" expression="salario*0.25"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="salariototal" expression="salariofinal+salario"/>
            <output expression="&quot;El usuario registrado con &quot;&amp; nombres &amp; apellidos &amp; &quot; identificado con  &quot; &amp; identificacion &amp; &quot; con a&#241;o de nacimiento:&quot; &amp; a&#241;onacimiento &amp; &quot; con direcci&#243;n en: &quot; &amp; direccion &amp;  &quot; con n&#250;mero de tel&#233;fono: &quot; &amp; telefono &amp; &quot; y con un salario inicial de: &quot; &amp; salario &amp; &quot; su salario final es de: &quot; &amp; salariototal" newline="True"/>
        </body>
    </function>
</flowgorithm>
