<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="dados4"/>
        <attribute name="authors" value="rtx3050"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-24 05:45:20 p.&#8239;m."/>
        <attribute name="created" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yMzswNjo0ODo1OSBhLuKAr20uOzExMjU2"/>
        <attribute name="edited" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yNDswNTo0NToyMCBwLuKAr20uOzM7MTEzNjY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <declare name="contador" type="Integer" array="False" size=""/>
            <assign variable="contador" expression="0"/>
            <declare name="dado1" type="Integer" array="False" size=""/>
            <declare name="dado2" type="Integer" array="False" size=""/>
            <declare name="salir" type="Integer" array="False" size=""/>
            <assign variable="salir" expression="0"/>
            <while expression="salir=0">
                <output expression="&quot;cuantas veces desea lanzar los dados?&quot;" newline="True"/>
                <input variable="numero"/>
                <assign variable="contador" expression="0"/>
                <while expression="contador&lt;numero">
                    <assign variable="dado1" expression="random(6)+1"/>
                    <assign variable="dado2" expression="random(6)+1"/>
                    <assign variable="contador" expression="contador+1"/>
                    <output expression="&quot;lanzamiento &quot; &amp; contador &amp; &quot; dado1= &quot; &amp; dado1 &amp; &quot; dado 2= &quot; &amp; dado2" newline="True"/>
                    <if expression="dado1=6 and dado2=6">
                        <then>
                            <output expression="&quot;salio par de 6,el programa finaliza&quot;" newline="True"/>
                            <assign variable="salir" expression="1"/>
                            <assign variable="contador" expression="numero"/>
                        </then>
                        <else/>
                    </if>
                </while>
            </while>
        </body>
    </function>
</flowgorithm>
