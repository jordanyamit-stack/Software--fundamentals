<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="dados6"/>
        <attribute name="authors" value="rtx3050"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-24 04:25:27 p.&#8239;m."/>
        <attribute name="created" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yNDswMzozNjozMSBwLuKAr20uOzExMjU2"/>
        <attribute name="edited" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yNDswNDoyNToyNyBwLuKAr20uOzE7MTEzNjg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="dado, totaltiros, suma, pares, impares" type="Integer" array="False" size=""/>
            <declare name="respuesta" type="String" array="False" size=""/>
            <assign variable="respuesta" expression="&quot;&quot;"/>
            <assign variable="totaltiros" expression="0"/>
            <assign variable="suma" expression="0"/>
            <assign variable="impares" expression="0"/>
            <assign variable="pares" expression="0"/>
            <output expression="&quot;desea lanzar el dado S/N&quot;" newline="True"/>
            <input variable="respuesta"/>
            <assign variable="respuesta" expression="respuesta"/>
            <while expression="(respuesta=&quot;s&quot;)or(respuesta=&quot;S&quot;)">
                <assign variable="dado" expression="random(6)+1"/>
                <output expression="&quot;salio: &quot; &amp; dado" newline="True"/>
                <assign variable="totaltiros" expression="totaltiros+1"/>
                <assign variable="suma" expression="suma*dado"/>
                <if expression="dado%2=0">
                    <then>
                        <assign variable="pares" expression="pares+1"/>
                    </then>
                    <else>
                        <assign variable="impares" expression="impares+1"/>
                    </else>
                </if>
                <output expression="&quot;desea volver a lanzar S/N&quot;" newline="True"/>
                <input variable="respuesta"/>
                <assign variable="respuesta" expression="respuesta"/>
            </while>
            <output expression="&quot;total de tiros efectiuados :&quot; &amp; totaltiros" newline="True"/>
            <output expression="&quot;suma total de los tiros: &quot; &amp; suma" newline="True"/>
            <output expression="&quot;total de pares generados: &quot; &amp; pares" newline="True"/>
            <output expression="&quot;total de impares generados :&quot; &amp; impares" newline="True"/>
        </body>
    </function>
</flowgorithm>
