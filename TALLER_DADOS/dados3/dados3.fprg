<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="dados3"/>
        <attribute name="authors" value="rtx3050"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-23 09:34:07 p.&#8239;m."/>
        <attribute name="created" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yMzswNjozOTo0MyBhLuKAr20uOzExMjQ5"/>
        <attribute name="edited" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yMzswOTozNDowNyBwLuKAr20uOzI7MTEzNzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="cara1" type="Integer" array="False" size=""/>
            <declare name="cara2" type="Integer" array="False" size=""/>
            <declare name="cara3" type="Integer" array="False" size=""/>
            <declare name="cara4" type="Integer" array="False" size=""/>
            <declare name="cara5" type="Integer" array="False" size=""/>
            <declare name="cara6" type="Integer" array="False" size=""/>
            <assign variable="cara1" expression="0"/>
            <assign variable="cara2" expression="0"/>
            <assign variable="cara3" expression="0"/>
            <assign variable="cara4" expression="0"/>
            <assign variable="cara5" expression="0"/>
            <assign variable="cara6" expression="0"/>
            <declare name="NUMEROTIROS" type="Integer" array="False" size=""/>
            <declare name="RESULTADO" type="Integer" array="False" size=""/>
            <output expression="&quot;digite el numero de tiros&quot;" newline="True"/>
            <input variable="NUMEROTIROS"/>
            <for variable="i" start="1" end="NUMEROTIROS" direction="inc" step="1">
                <assign variable="RESULTADO" expression="random(6)+1"/>
                <if expression="RESULTADO=1">
                    <then>
                        <assign variable="cara1" expression="cara1+1"/>
                    </then>
                    <else>
                        <if expression="RESULTADO=2">
                            <then>
                                <assign variable="cara2" expression="cara2+1"/>
                            </then>
                            <else>
                                <if expression="RESULTADO=3">
                                    <then>
                                        <assign variable="cara3" expression="cara3+1"/>
                                    </then>
                                    <else>
                                        <if expression="RESULTADO=4">
                                            <then>
                                                <assign variable="cara4" expression="cara4+1"/>
                                            </then>
                                            <else>
                                                <if expression="RESULTADO=5">
                                                    <then>
                                                        <assign variable="cara5" expression="cara5+1"/>
                                                    </then>
                                                    <else>
                                                        <assign variable="cara6" expression="cara6+1"/>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="&quot;total de lanzamientos &quot; &amp; NUMEROTIROS" newline="True"/>
            <output expression="&quot;El numero 1 salio &quot; &amp; cara1 &amp;&quot; veces&quot;" newline="True"/>
            <output expression="&quot;El numero 2 salio &quot; &amp; cara2 &amp;&quot; veces&quot;" newline="True"/>
            <output expression="&quot;El numero 3 salio &quot; &amp; cara3 &amp;&quot; veces&quot;" newline="True"/>
            <output expression="&quot;El numero 4 salio &quot; &amp; cara4 &amp;&quot; veces&quot;" newline="True"/>
            <output expression="&quot;El numero 5 salio &quot; &amp; cara5 &amp;&quot; veces&quot;" newline="True"/>
            <output expression="&quot;El numero 6 salio &quot; &amp; cara6 &amp;&quot; veces&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
