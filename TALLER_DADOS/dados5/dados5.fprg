<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="dados5"/>
        <attribute name="authors" value="rtx3050"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-23 10:47:36 p.&#8239;m."/>
        <attribute name="created" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yMzsxMDozODo0MiBwLuKAr20uOzExMjU3"/>
        <attribute name="edited" value="cnR4MzA1MDtMQVBUT1AtQlNBVTgxNEU7MjAyNS0xMS0yMzsxMDo0NzozNiBwLuKAr20uOzE7MTEzNjg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, i, dado, pares, impares" type="Integer" array="False" size=""/>
            <assign variable="pares" expression="0"/>
            <assign variable="impares" expression="0"/>
            <output expression="&quot;numero de lanzamientos :&quot;" newline="True"/>
            <input variable="numero"/>
            <for variable="i" start="1" end="numero" direction="inc" step="1">
                <assign variable="dado" expression="random(6)+1"/>
                <output expression="&quot;lanzamiento &quot; &amp; i &amp; &quot; : &quot; &amp; dado" newline="True"/>
                <if expression="dado%2=0">
                    <then>
                        <assign variable="pares" expression="pares+1"/>
                    </then>
                    <else>
                        <assign variable="impares" expression="impares+1"/>
                    </else>
                </if>
            </for>
            <output expression="&quot;total tiros impares &quot; &amp; impares" newline="True"/>
            <output expression="&quot;total tiros pares &quot; &amp; pares" newline="True"/>
        </body>
    </function>
</flowgorithm>
